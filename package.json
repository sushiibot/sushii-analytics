{
  "name": "sushii-analytics",
  "module": "./src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run ./src/index.ts",
    "dev": "bun run --watch ./src/index.ts | pino-pretty",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "backfill": "bun run ./src/cli/backfill.ts",
    "merge": "bun run ./src/cli/merge.ts",
    "derive": "bun run ./src/cli/derive.ts",
    "delete-user": "bun run ./src/cli/delete-user.ts",
    "delete-guild": "bun run ./src/cli/delete-guild.ts",
    "opt-out": "bun run ./src/cli/opt-out.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "pino-pretty": "^13.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.1",
    "@opentelemetry/instrumentation": "^0.57.1",
    "@opentelemetry/instrumentation-undici": "^0.10.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "discord-api-types": "^0.37.119",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  }
}
